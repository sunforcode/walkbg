# 部署环境变量模板
#
# 使用方式：复制为同目录下的 .env 并填入真实值。
#   cp .env.example .env
# .env 含密钥，不要提交到仓库。
#
# 标注「必填」的项没有默认值，缺失时服务会启动失败——
# 这是刻意设计：宁可启动失败，也不要用默认值悄悄跑起来。

# ========================================
# 数据库（必填）
# ========================================
# MySQL root 密码。首次启动会以此初始化数据库，
# 之后修改此值不会自动改变已有数据卷中的密码。
MYSQL_ROOT_PASSWORD=

# 数据库名，需与 walkbg 的迁移脚本一致
MYSQL_DATABASE=walkbg

# 连接池上限。这台机器内存有限，不宜过大。
DB_POOL_MAX=10

# ========================================
# 后端安全（必填）
# ========================================
# JWT 签名密钥，HS256 要求至少 256 位（32 字节）。
# 生成方式：openssl rand -base64 48
JWT_SECRET=

# 允许的跨域来源，逗号分隔。
# 前后端同源部署时留空即可。
CORS_ALLOWED_ORIGINS=

# ========================================
# LLM（必填）
# ========================================
# 注意：请使用新申请的 Key。
# 历史提交中曾包含一个 DeepSeek Key，该 Key 已泄露，必须废弃。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# ========================================
# 对外端口
# ========================================
# 80 端口在国内需完成备案才能对外提供 HTTP 服务。
# 备案未通过前可设为 8080，并通过 SSH 隧道访问验证。
WEB_PORT=80
